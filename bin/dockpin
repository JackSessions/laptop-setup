#!/usr/bin/env python3
"""Pin apps to the bottom dock, and switch it between auto-hide and always-visible.

  dockpin add obsidian        pin by app name or desktop id (searches installed apps)
  dockpin rm obsidian         unpin
  dockpin ls                  show pinned apps (and which ones are installed)
  dockpin mode auto|always    auto = hides until the cursor touches the bottom edge, always = stays visible
"""
import glob, os, re, subprocess, sys

PINS = os.path.expanduser("~/.cache/nwg-dock-pinned")
MODE = os.path.expanduser("~/.config/hypr/dock-mode")
DIRS = [os.path.expanduser("~/.local/share/applications"), "/usr/share/applications", "/var/lib/snapd/desktop/applications"]


def apps():
    out = {}
    for d in DIRS:
        for f in glob.glob(d + "/*.desktop"):
            i = os.path.basename(f)[:-8]
            if i in out:
                continue
            name = ""
            for line in open(f, errors="ignore"):
                if line.startswith("Name="):
                    name = line[5:].strip(); break
            if "NoDisplay=true" in open(f, errors="ignore").read():
                continue
            out[i] = name
    return out


def pins():
    return [l.strip() for l in open(PINS)] if os.path.exists(PINS) else []


def restart():
    subprocess.Popen([os.path.expanduser("~/.config/hypr/scripts/Dock.sh"), "restart"], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def find(q):
    a = apps(); ql = q.lower()
    if q in a:
        return [q]
    exact = [i for i, n in a.items() if n.lower() == ql or i.lower() == ql]
    if exact:
        return exact
    return [i for i, n in a.items() if ql in i.lower() or ql in n.lower()]


def main():
    a = sys.argv[1:]
    if not a or a[0] == "ls":
        ins = apps()
        for p in pins():
            print(("  " if p in ins else "? "), p, "-", ins.get(p, "(not installed)"))
    elif a[0] == "add" and len(a) == 2:
        m = find(a[1])
        if len(m) != 1:
            print("no match" if not m else "several matches, be more specific:\n  " + "\n  ".join(f"{i}  ({apps()[i]})" for i in m)); sys.exit(1)
        if m[0] in pins():
            print("already pinned"); return
        open(PINS, "a").write(m[0] + "\n"); print(f"pinned {m[0]}"); restart()
    elif a[0] == "rm" and len(a) == 2:
        before = pins()
        keep = [p for p in before if p != a[1] and a[1].lower() not in p.lower()]
        open(PINS, "w").write("".join(p + "\n" for p in keep))
        print(f"unpinned {len(before) - len(keep)}" if len(keep) != len(before) else "not pinned"); restart()
    elif a[0] == "mode" and len(a) == 2 and a[1] in ("auto", "always"):
        os.makedirs(os.path.dirname(MODE), exist_ok=True); open(MODE, "w").write(a[1] + "\n"); print("dock mode:", a[1]); restart()
    else:
        print(__doc__)


if __name__ == "__main__":
    main()
