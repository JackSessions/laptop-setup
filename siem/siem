#!/usr/bin/env bash
# Control the local SIEM (Elastic stack in Podman). Usage: siem up|down|status|pass|url|dashboards|rules [--list]
set -euo pipefail
D=/etc/siem
c() { sudo podman-compose --env-file $D/.env -f $D/compose.yml "$@"; }
case "${1:-status}" in
  up)     c up -d; echo "Kibana: http://127.0.0.1:5601  (user: elastic, password: siem pass). Takes ~1-2 min to start." ;;
  down)   c down ;;
  status) sudo podman ps --filter label=io.podman.compose.project=siem --format '{{.Names}}  {{.Status}}'
          curl -fs -u "elastic:$(sudo sed -n 's/^ELASTIC_PASSWORD=//p' $D/.env)" 127.0.0.1:9200/_cat/indices?h=index,docs.count,store.size 2>/dev/null | sort | tail -15 || true ;;
  pass)   sudo sed -n 's/^ELASTIC_PASSWORD=//p' $D/.env ;;
  url)    echo http://127.0.0.1:5601 ;;
  dashboards) python3 -I "${SIEM_DIR:-$HOME/laptop-setup/siem}/dashboards.py" ;;
  rules)  shift; python3 -I "${SIEM_DIR:-$HOME/laptop-setup/siem}/rules.py" "$@" ;;
  *)      echo "Usage: siem up|down|status|pass|url|dashboards|rules [--list]"; exit 1 ;;
esac
